{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fazlerasheed-landing",
  "main": "worker.ts",
  "compatibility_date": "2026-06-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Route crawler-facing files through the Worker so DataFast's
    // withAICrawlerTracking (in worker.ts) sees bot requests to them.
    // Without this, Cloudflare serves these static assets directly and
    // bypasses the Worker, so robots.txt/llms.txt/sitemap hits go untracked.
    // All other static assets stay served directly (fast, no Worker invoke).
    "run_worker_first": [
      "/robots.txt",
      "/llms.txt",
      "/sitemap.xml"
    ]
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "fazlerasheed-landing"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
